---
import { site, hero } from '../../content/site.js';
import Round from '../Round.astro';
const { media } = hero;
---

<section id="hero" class="hero relative w-full h-screen overflow-hidden bg-char text-warm">
  {/* The background is a real photo/video slot — never a canvas, SVG or
      generated pattern (site/home-page). Until the assets land this renders
      a labelled placeholder. */}
  <div class="absolute inset-0" aria-hidden="true">
    {media.video ? (
      <video
        class="w-full h-full object-cover"
        poster={media.poster}
        muted
        playsinline
        loop
        preload="none"
        data-hero-video
        data-src={media.video}
      ></video>
    ) : media.poster ? (
      <img class="w-full h-full object-cover" src={media.poster} alt="" fetchpriority="high" decoding="sync" />
    ) : (
      <div class="ph-0 w-full h-full"></div>
    )}
  </div>

  <div class="hero__copy">
    <h1 class="headline text-center [text-wrap:balance]">{hero.headline}</h1>
    <div class="mt-[30px] flex justify-center">
      <Round href={site.links[hero.cta.key]} label={hero.cta.label} />
    </div>
  </div>

  {!media.video && !media.poster && (
    <p class="absolute z-[4] left-[30px] bottom-7 max-w-[24ch] font-ui text-[9px] font-semibold
              tracking-[.2em] uppercase leading-[1.9] text-warm/40 hidden md:block">
      <b class="block text-warm/25 font-semibold">video placeholder</b>{media.slug}
    </p>
  )}
</section>
