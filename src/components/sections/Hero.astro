---
import { site, hero } from '../../content/site.js';
import Round from '../Round.astro';
const { media } = hero;
---

<section id="hero" class="hero relative w-full h-screen overflow-hidden bg-char text-warm">
  {/* A shader (scripts/smoke.js) over the poster: the poster is what shows without WebGL or under reduced motion. */}
  <div class="absolute inset-0" aria-hidden="true">
    <img class="w-full h-full object-cover" src={media.poster} alt="" fetchpriority="high" decoding="sync" />
    <canvas class="smoke" data-smoke></canvas>
  </div>

  <div class="hero__copy">
    <h1 class="headline text-center [text-wrap:balance]">{hero.headline}</h1>
    <div class="mt-[30px] flex justify-center">
      <Round href={site.links[hero.cta.key]} label={hero.cta.label} />
    </div>
  </div>

</section>
