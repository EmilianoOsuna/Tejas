---
import { merch } from '../../content/collections.js';
import { site } from '../../content/site.js';
import Plate from '../Plate.astro';
---

<section id="merch" class="py-band">
  <div class="wrap">
    <div class="flex flex-wrap gap-5 justify-between items-end mb-[clamp(34px,5vw,60px)]">
      <div class="text-left">
        <p class="label label-red">wear it home</p>
        <h2 class="text-d3" data-split>ten years of smoke</h2>
      </div>
      <a class="tlink tlink-on" href={site.links.shop}>Shop all</a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-[clamp(16px,2.4vw,34px)]">
      {merch.map((m) => (
        <a class="grid gap-3.5 no-underline text-inherit group" href={site.links.shop}>
          <Plate mask={m.mask} slug={m.slug} class="w-full" sizes="(min-width: 760px) 22vw, 45vw" />
          <div>
            <div class="font-display font-semibold text-[17px] lowercase leading-[1.5] group-hover:text-red" style="font-variation-settings:'opsz' 18">{m.name}</div>
            <div class="font-ui text-[11px] font-semibold tracking-[.14em] text-smoke">{m.price}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
